def _extract_row(text, labels, col=0, guard_commitment=False):
    """
    Extract value from labelled row.

    Guards:
    1. Dedicated beginning parsers ONLY for beginning labels
    2. Skip beginning/opening lines for flow searches
    3. Skip cumulative/recallable/total/less summary lines
    4. Skip single-negative commitment lines (guard_commitment)
    """
    is_beginning_search = col == 0 and any(
        re.search(
            r'beginning|opening|balance.*at.*\d{4}|'
            r'Capital\s+Account\s+Balance\s+at|'
            r'BeginningNAV|Beginning\s+NAV|'
            r'Beginning\s+Loan|LP\s+&\s+CIP',
            label, re.IGNORECASE
        )
        for label in labels
    )

    if is_beginning_search:
        if re.search(
            r'Hampshire\s+Partners', text, re.IGNORECASE
        ):
            val = _extract_hampshire_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'PLATINUM\s+EQUITY\s+(?:CAPITAL\s+PARTNERS|'
            r'CONTINUATION)',
            text, re.IGNORECASE
        ):
            val = _extract_platinum_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'New\s+Heritage\s+Capital', text, re.IGNORECASE
        ):
            val = _extract_new_heritage_beginning(text)
            if val is not None:
                return val

        if re.search(r'ORCHID\s+ASIA', text, re.IGNORECASE):
            val = _extract_orchid_beginning(text)
            if val is not None:
                return val

        if re.search(r'FountainVest', text, re.IGNORECASE):
            val = _extract_fountainvest_beginning(text)
            if val is not None:
                return val

        if re.search(r'CSIM\s+Aligned', text, re.IGNORECASE):
            val = _extract_csim_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'Meadow\s+Real\s+Estate\s+Fund\s+V',
            text, re.IGNORECASE
        ):
            val = _extract_meadow_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'Greenfield\s+Land\s+Partners',
            text, re.IGNORECASE
        ):
            val = _extract_greenfield_beginning(text)
            if val is not None:
                return val

        if re.search(r'CANAAN', text, re.IGNORECASE):
            val = _extract_canaan_beginning(text, col=col)
            if val is not None:
                return val

        if re.search(
            r'Sorenson\s+Capital', text, re.IGNORECASE
        ):
            val = _extract_sorenson_beginning(text)
            if val is not None:
                return val

        if re.search(r'DAG\s+Ventures', text, re.IGNORECASE):
            val = _extract_dag_beginning(text)
            if val is not None:
                return val

        if re.search(r'RRJ\s+Capital', text, re.IGNORECASE):
            val = _extract_rrj_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'CVC\s+Capital\s+Partners\s+VIII',
            text, re.IGNORECASE
        ):
            val = _extract_cvc_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'SMALL\s+CAPS\s+OPPORTUNITIES',
            text, re.IGNORECASE
        ):
            val = _extract_small_caps_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'SPARRING\s+CAPITAL', text, re.IGNORECASE
        ):
            val = _extract_sparring_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'Africa\s+Top\s+Invest', text, re.IGNORECASE
        ):
            val = _extract_africa_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'MREP\s+Global|Metropolitan\s+RE\s+Global',
            text, re.IGNORECASE
        ):
            val = _extract_simple_beginning_balance(text)
            if val is not None:
                return val

        if re.search(
            r'Partners\s+Group\s+Real\s+Estate\s+Secondary|'
            r'RREF\s+Direct|PAREFVIIISECONDARIES',
            text, re.IGNORECASE
        ):
            val = _extract_partners_group_beginning(text)
            if val is not None:
                return val

        if re.search(
            r'SREP\s+Port\s+Logistics|'
            r'Stonepeak\s+Real\s+Estate\s+Associates',
            text, re.IGNORECASE
        ):
            val = _extract_stonepeak_beginning(text)
            if val is not None:
                return val

    is_flow_search = any(
        re.search(
            r'distribution|contribution|return\s+of',
            label, re.IGNORECASE
        )
        for label in labels
    )

    lines = text.split('\n')
    for label in labels:
        for i, line in enumerate(lines):
            if not re.search(label, line, re.IGNORECASE):
                continue

            # Guard 1: skip beginning/opening lines
            if is_flow_search and re.search(
                r'\bbeginning\b|\bopening\b|\bstarting\b',
                line, re.IGNORECASE
            ):
                continue

            # Guard 2: skip summary/recap lines
            if is_flow_search and re.search(
                r'\bCumulative\b|\bRecallable\b|'
                r'\bTotal\s+(?:Distributions|Contributions)\b|'
                r'^\s*Less\s+',
                line, re.IGNORECASE
            ):
                continue

            # Guard 3: skip single-negative commitment lines
            if guard_commitment:
                quick_nums = _extract_numbers(line)
                if (len(quick_nums) == 1
                        and quick_nums[0] < 0):
                    continue

            lookahead = 6 if re.search(
                r'Partners|Beginning|Opening',
                label, re.IGNORECASE
            ) else 3
            combined = line
            for j in range(1, lookahead + 1):
                if i + j < len(lines):
                    combined += ' ' + lines[i + j]
            combined = _strip_percentages(combined)
            nums     = _extract_numbers(combined)
            if len(nums) > col:
                return nums[col]

    return None


