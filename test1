    r"Ending\s+Capital\s+Account\s+Balance",
    r'Ending.*?[Bb]alance',
    r'Partners.*?capital.*?end',
]
_MONTHS = (
    r'(?:January|February|March|April|May|June|'
    r'July|August|September|October|November|December)'
)
_MONTH_PATTERN = (
    r'(?:January|February|March|April|May|June|'
    r'July|August|September|October|November|December)'
    r'\s+\d{1,2},?\s+\d{4}'
)


def _strip_date(text):
    return re.sub(
        _MONTH_PATTERN, '', text, flags=re.IGNORECASE
    )


def _strip_percentages(text):
    cleaned = re.sub(r'\d+\.\d+%', '', text)
    cleaned = re.sub(
        r'(?<!\d)(\d{1,2}\.\d{4})(?!\d)', '', cleaned
    )
    return cleaned


def _normalize_european_numbers(text):
    cleaned = re.sub(
        r'(\d)\s+(\d{3})(?=\s|\d|,|\.|\b)', r'\1\2', text
    )
    cleaned = re.sub(r'(\d),(\d{2})(?!\d)', r'\1.\2', cleaned)
    return cleaned


def _normalize_swiss_numbers(text):
    return re.sub(r"(\d)'(\d)", r'\1\2', text)


