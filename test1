def _extract_dfj_ending(text):
    """
    DFJ / Threshold Ventures:
    Line: "End of Period $3,621,549"
    Extract $ value directly.
    """
    lines = text.split('\n')
    for line in lines:
        if not re.search(
            r'End\s+of\s+Period', line, re.IGNORECASE
        ):
            continue
        nums = re.findall(r'\$\s*([\d,]+(?:\.\d+)?)', line)
        for n in nums:
            try:
                val = float(n.replace(',', ''))
                if val > 100:
                    return val
            except ValueError:
                pass
    return None


def _extract_pa2014_ending(text):
    """
    PA2014 Private Equity Fund I:
    Line: "Closing Capital Account Balance 53,591,828 53,591,828"
    Returns (ytd, ytd, itd) tuple.
    """
    lines = text.split('\n')
    for line in lines:
        if not re.search(
            r'Closing\s+Capital\s+Account\s+Balance',
            line, re.IGNORECASE
        ):
            continue
        nums = re.findall(r'[\d,]+(?:\.\d+)?', line)
        values = []
        for n in nums:
            try:
                val = float(n.replace(',', ''))
                if val > 1000:
                    values.append(val)
            except ValueError:
                pass
        if len(values) >= 2:
            return values[0], values[1], values[1]
        elif len(values) >= 1:
            v = values[0]
            return v, v, v
    return None


def _extract_peg_ending(text):
    """
    PEG Secondary Private Equity — multi-fund summary format.

    File has two table sections:
    1. Since Inception: "Total Funds: 93,997,513 0 46,502,066..."
    2. QTD (Oct-Dec):   "Total Funds: 93,997,513 16,069,208 0..."

    Use SECOND Total Funds line = QTD section.
    Ending capital = last large number on that line.

    Fixes:
    - EndQTD=31 from date "12/31/2025" in file header
    - DistribQTD=36M from Opening Capital in table row
    Both avoided by using dedicated parser.
    """
    lines = text.split('\n')
    total_funds_lines = []

    for i, line in enumerate(lines):
        if re.search(
            r'Total\s+Funds:', line, re.IGNORECASE
        ):
            total_funds_lines.append((i, line))

    # Second Total Funds line = QTD section
    target_lines = (
        total_funds_lines[1:2]
        if len(total_funds_lines) >= 2
        else total_funds_lines
    )

    for i, line in target_lines:
        window = line
        if i + 1 < len(lines):
            window += ' ' + lines[i + 1]

        cleaned = _strip_date(_strip_percentages(window))
        nums    = _extract_numbers(cleaned)
        nums    = [n for n in nums if abs(n) > 1000]

        if nums:
            return nums[-1]

    return None


def _extract_cpechina_ending(text):
    """CPEChina Fund II — Closing Capital as of 31 December."""
    lines = text.split('\n')
