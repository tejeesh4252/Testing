        result.get("Beginning Balance YTD") is not None,
        result.get("Contributions ITD")     is not None,
        result.get("Capital Commitment")    is not None,
    ])
    if not has_ending:
        notes.append("Missing ending balance")
        result["Extraction Status"] = "PARTIAL"
    elif not has_beginning:
        notes.append("Missing beginning balance")
        result["Extraction Status"] = "PARTIAL"
    else:
        result["Extraction Status"] = "SUCCESS"
    result["Extraction Notes"] = " | ".join(notes)
    return result
