# -*- coding: utf-8 -*-
import re


def extract(full_text, filename):
    """
    Extractor for Revolution Growth/Ventures format.
    Also covers: Sorenson, DAG Ventures, Marlin, OrbiMed,
    American Securities, Saw Mill, SPC Partners, Swander Pace,
    Caltius, GenNx360, Glouston, New Heritage, BPOC Ventus,
    Beecken Petty, Columbia Capital, PA2014, Tengram, KKR Asian,
    Orchid Asia, CPEChina, FountainVest, Baring Asia,
    DFJ/Threshold, Indium V, Waud/Norwest, Norwest Mezzanine,
    Platinum Equity, Riverside, Insight Venture, Harbert,
    Fireside, Greenfield, Meadow RE, Carlyle Realty,
    Hampshire Partners, CSIM, Canaan, Sorenson, DAG Ventures,
    RRJ Capital, CVC Capital, Small Caps, Sparring Capital,
    Africa Top Invest, Partners Group RE, Metropolitan RE Global,
    Stonepeak RE, Rialto RE, JBG Urban, PEG Secondary
    """
    result = {
        "Extraction Status": "SUCCESS",
        "Extraction Notes": "",
        "Template Used":    "Revolution",
        "Currency":         "USD",
    }

    # ── SKIP: Valuation memos and appraisal reports ────────────────────────
    # These are not capital account statements — no financial data to extract
    if re.search(
        r'Valuation Memo|Appraisal Report|PORTFOLIO REVIEW'
        r'|Investment Type:|PA Vehicle',
        filename, re.IGNORECASE
    ) or re.search(
        r'PORTFOLIO REVIEW\s*\n.*?Investment(?:\s+Project|\s+Type)',
        full_text, re.IGNORECASE
    ):
        result["Extraction Status"] = "SKIP"
        result["Extraction Notes"]  = (
            "Valuation memo or appraisal report — "
            "not a capital account statement"
        )
        return result
    # ── END SKIP ──────────────────────────────────────────────────────────

    try:
        if _is_fmv_schedule(full_text):
            result["Extraction Status"] = "SKIP"
            result["Extraction Notes"]  = (
                "Fair Market Value schedule — "
                "no capital account data"
            )
            return result

        result["Fund Name"]     = _extract_fund_name(
            full_text, filename
        )
        result["Investor Name"] = _extract_investor_name(
            full_text
        )
        result["Report Date"]   = _extract_report_date(
            full_text
        )
        result["Ownership %"]   = _extract_ownership(full_text)

        result["Capital Commitment"]  = _extract_commitment(
            full_text
        )
        result["Unfunded Commitment"] = _extract_unfunded(
            full_text
        )

        _beg_labels = [
            "Beginning balance",
            "Beginning capital",
            r"Beginning.s?\s+Capital",
            "Partners' capital, beginning",
            "Partners' capital, beginning of",
            "Capital account balance.*January",
            "Opening Capital",
            "Partners' capital at Jan",
            "Balance, beginning",
            "Capital.*January 1",
            r"Capital account.*?beginning",
            r"Balance at.*?(?:January|February|March|April|May|June|"
            r"July|August|September|October|November|December)\s+\d",
            r"Partners.*?capital.*?beginning",
            r"Capital.*?beginning of period",
            r"Opening balance",
            r"Balance.*?beginning of",
            r"Net assets.*?beginning",
            r"Balance\s+at\s+\d{1,2}/\d{1,2}/20\d{2}",
            r"Beginning\s+Partners['']?\s+Capital",
            r"Beginning\s+Partners['']?\s+Deficit",
            r"Opening\s+Partner.s\s+Capital",
            r"Opening\s+Capital\s+(?:Account\s+)?Balance",
            r"Beginning\s+of\s+Period",
            r"Capital\s+Account\s+Balance\s+at\s+\d",
            r"Partner.s\s+capital\s+as\s+of\s+December\s+31,\s+20\d{2}",
            r"Partner.s\s+Capital,\s+\d+\s+January\s+\d{4}",
            r"Partner.s\s+Capital,\s+01\s+January",
            r"Beginning\s+Loan\s+Value",
            r"Net\s+Asset\s+Value\s+.+Units\s+as\s+of\s+30\s+September",
            r"LP\s+&\s+CIP\s+Interests\s+-\s+30th\s+September",
            r"Beginning\s+Capital\s+Balance",
        ]

        result["Beginning Balance QTD"] = _extract_row(
            full_text, _beg_labels, col=0
        )
        result["Beginning Balance YTD"] = _extract_row(
            full_text, _beg_labels, col=1
        )

        _cont_labels = [
            "Capital contributions",
            "Contributions",
            "Net capital contributions",
            "Net capital contr",
        ]
        result["Contributions QTD"] = _extract_row(
            full_text, _cont_labels, col=0,
            guard_commitment=True
        )
        result["Contributions YTD"] = _extract_row(
            full_text, _cont_labels, col=1,
            guard_commitment=True
        )
        result["Contributions ITD"] = _extract_row(
            full_text, _cont_labels, col=2,
            guard_commitment=True
        )
        _dist_labels = [
            "Capital distributions",
            "Distributions",
            "Return of Capital",
            "Return of capital",
        ]
        if re.search(r'CANAAN', full_text, re.IGNORECASE):
            result["Distributions QTD"] = (
                _extract_canaan_distributions(full_text, col=0)
            )
            result["Distributions YTD"] = (
                _extract_canaan_distributions(full_text, col=1)
            )
            result["Distributions ITD"] = None
        else:
            result["Distributions QTD"] = _extract_row(
                full_text, _dist_labels, col=0,
                guard_commitment=True
            )
            result["Distributions YTD"] = _extract_row(
                full_text, _dist_labels, col=1,
                guard_commitment=True
            )
            result["Distributions ITD"] = _extract_row(
                full_text, _dist_labels, col=2,
                guard_commitment=True
            )

        _nii_labels = [
            "Net investment income",
            "Net income",
            "Income / Loss",
            "Investment income",
            "Net operating income",
            "Net investment loss",
        ]
        if re.search(r'CANAAN', full_text, re.IGNORECASE):
            result["Net Investment Income QTD"] = (
                _extract_canaan_nii(full_text, col=0)
            )
            result["Net Investment Income YTD"] = (
                _extract_canaan_nii(full_text, col=1)
            )
            result["Net Investment Income ITD"] = None
        else:
            result["Net Investment Income QTD"] = _extract_row(
                full_text, _nii_labels, col=0
            )
            result["Net Investment Income YTD"] = _extract_row(
                full_text, _nii_labels, col=1
            )
            result["Net Investment Income ITD"] = _extract_row(
                full_text, _nii_labels, col=2
            )

        _real_labels = [
            "Net realized gain",
            "Realized gain",
            "Gain/Loss on investments",
            "Net realized",
        ]
        result["Net Realized Gain/Loss QTD"] = _extract_row(
            full_text, _real_labels, col=0
        )
        result["Net Realized Gain/Loss YTD"] = _extract_row(
            full_text, _real_labels, col=1
        )
        result["Net Realized Gain/Loss ITD"] = _extract_row(
            full_text, _real_labels, col=2
        )

        _unreal_labels = [
            "Net change in unrealized",
            "Unrealized gain",
            "Change in fair value",
            "Net unrealized",
            "Change in net unrealized",
        ]
        result["Net Unrealized Gain/Loss QTD"] = _extract_row(
            full_text, _unreal_labels, col=0
        )
        result["Net Unrealized Gain/Loss YTD"] = _extract_row(
            full_text, _unreal_labels, col=1
        )
        result["Net Unrealized Gain/Loss ITD"] = _extract_row(
            full_text, _unreal_labels, col=2
        )

        _mgmt_labels = [
            "Management fees",
            "Management fee",
        ]
        result["Management Fees QTD"] = _extract_row(
            full_text, _mgmt_labels, col=0
        )
        result["Management Fees YTD"] = _extract_row(
            full_text, _mgmt_labels, col=1
        )
        result["Management Fees ITD"] = _extract_row(
            full_text, _mgmt_labels, col=2
        )

        _carry_labels = [
            "Incentive allocation",
            "Carried interest",
            "Performance fee",
            "Provision for carried interest",
        ]
        result["Carried Interest QTD"] = _extract_row(
            full_text, _carry_labels, col=0
        )
        result["Carried Interest YTD"] = _extract_row(
            full_text, _carry_labels, col=1
        )
        result["Carried Interest ITD"] = _extract_row(
            full_text, _carry_labels, col=2
        )

        qtd, ytd, itd = _extract_ending_all_cols(full_text)
        result["Ending Balance QTD"] = qtd
        result["Ending Balance YTD"] = ytd
        result["Ending Balance ITD"] = itd

        result["IRR"]  = _extract_irr(full_text)
        result["MOIC"] = _extract_moic(full_text)

    except Exception as e:
        result["Extraction Status"] = "ERROR"
        result["Extraction Notes"]  = str(e)
        return result

    result = _validate_result(result)
    return result


