# ENDING BALANCE — MULTI-PASS EXTRACTOR
# ══════════════════════════════════════════════════════════════

def _extract_ending_all_cols(full_text):
    """
    Master ending-balance extractor.
    Priority:
    0. Fund-specific special parsers
    1. Label scanning (>100 filter)
    2. Deduplicate candidates
    3. Single unique value -> all three columns
    """
    hampshire_end = _extract_hampshire_ending(full_text)
    if hampshire_end is not None:
        return hampshire_end, hampshire_end, hampshire_end

    orchid_val = _extract_orchid_ending(full_text)
    if orchid_val is not None:
        return orchid_val, orchid_val, orchid_val

    fountainvest_val = _extract_fountainvest_ending(full_text)
    if fountainvest_val is not None:
        return (
            fountainvest_val,
            fountainvest_val,
            fountainvest_val,
        )

    # ── DFJ / Threshold Ventures ──────────────────────────────
    # "End of Period $3,621,549" — extract $ directly
    # avoids position_id numbers leaking via label scan
    if re.search(
        r'Draper\s+Fisher|Threshold\s+Ventures',
        full_text, re.IGNORECASE
    ):
        dfj_val = _extract_dfj_ending(full_text)
        if dfj_val is not None:
            return dfj_val, dfj_val, dfj_val

    # ── PA2014 ────────────────────────────────────────────────
    # "Closing Capital Account Balance 53,591,828 53,591,828"
    if re.search(
        r'PA2014\s+Private\s+Equity',
        full_text, re.IGNORECASE
    ):
        pa2014_val = _extract_pa2014_ending(full_text)
        if pa2014_val is not None:
            if isinstance(pa2014_val, tuple):
                return pa2014_val
            return pa2014_val, pa2014_val, pa2014_val

    # ── PEG Secondary ─────────────────────────────────────────
    # Multi-fund summary — finds QTD Total Funds ending value
    if re.search(
        r'PEG\s+Secondary\s+Private\s+Equity',
        full_text, re.IGNORECASE
    ):
        peg_val = _extract_peg_ending(full_text)
        if peg_val is not None:
            return peg_val, peg_val, peg_val

    cpechina2_val = _extract_cpechina_ending(full_text)
    if cpechina2_val is not None:
        if isinstance(cpechina2_val, tuple):
            return cpechina2_val
        return cpechina2_val, cpechina2_val, cpechina2_val

    cpechina3_val = _extract_cpechina3_ending(full_text)
    if cpechina3_val is not None:
        if isinstance(cpechina3_val, tuple):
            return cpechina3_val
        return cpechina3_val, cpechina3_val, cpechina3_val

    canaan_val = _extract_canaan_ending(full_text)
    if canaan_val is not None:
        return canaan_val, canaan_val, canaan_val

    sorenson_val = _extract_sorenson_ending(full_text)
    if sorenson_val is not None:
        return sorenson_val

    dag_val = _extract_dag_ending(full_text)
    if dag_val is not None:
        return dag_val, dag_val, dag_val

    rrj_val = _extract_rrj_ending(full_text)
    if rrj_val is not None:
        return rrj_val, rrj_val, rrj_val

    cvc_val = _extract_cvc_ending(full_text)
    if cvc_val is not None:
        return cvc_val, cvc_val, cvc_val

    small_caps_val = _extract_small_caps_ending(full_text)
    if small_caps_val is not None:
        return small_caps_val, small_caps_val, small_caps_val

    sparring_val = _extract_sparring_ending(full_text)
    if sparring_val is not None:
        return sparring_val, sparring_val, sparring_val

    africa_val = _extract_africa_ending(full_text)
    if africa_val is not None:
        return africa_val, africa_val, africa_val

    metro_val = _extract_simple_ending_balance(full_text)
    if metro_val is not None:
        return metro_val, metro_val, metro_val

    partners_val = _extract_partners_group_ending(full_text)
    if partners_val is not None:
        return partners_val, partners_val, partners_val

    stonepeak_val = _extract_stonepeak_ending(full_text)
    if stonepeak_val is not None:
        return stonepeak_val, stonepeak_val, stonepeak_val

    csim_val = _extract_csim_ending(full_text)
    if csim_val is not None:
        return csim_val, csim_val, csim_val

    meadow_val = _extract_meadow_ending(full_text)
    if meadow_val is not None:
        return meadow_val, meadow_val, meadow_val

    greenfield_val = _extract_greenfield_ending(full_text)
    if greenfield_val is not None:
        return greenfield_val, greenfield_val, greenfield_val

    new_heritage_val = _extract_new_heritage_ending(full_text)
    if new_heritage_val is not None:
        return (
            new_heritage_val,
            new_heritage_val,
            new_heritage_val,
        )

    platinum_totals = _extract_platinum_totals(full_text)
    if platinum_totals is not None:
        return platinum_totals, platinum_totals, platinum_totals

    platinum_col = _extract_platinum_ending(full_text)
    if platinum_col is not None:
        return platinum_col, platinum_col, platinum_col

    caltius_val = _extract_caltius_ending(full_text)
    if caltius_val is not None:
        return caltius_val, caltius_val, caltius_val

    # ── Label-based scanning ───────────────────────────────────
    lines = full_text.split('\n')
    n     = len(lines)
    hits  = []

    for label in _ENDING_LABELS:
        for i, line in enumerate(lines):
            if not re.search(label, line, re.IGNORECASE):
                continue

            window = line
            for j in range(1, 4):
                if i + j < n:
                    next_line = lines[i + j]
                    if re.match(
                        r'^[A-Z][A-Z\s]{10,}$',
                        next_line.strip()
                    ):
                        break
                    window += ' ' + next_line

            cleaned = _strip_date(window)
            cleaned = _strip_percentages(cleaned)
            nums    = _extract_numbers(cleaned)
            nums    = [n for n in nums if abs(n) > 100]

            if nums:
                hits.append((i, nums))

        if any(len(h[1]) >= 3 for h in hits):
            break

    if not hits:
        return None, None, None

    for _, nums in hits:
        if len(nums) >= 3:
            return nums[0], nums[1], nums[2]

    for _, nums in hits:
        if len(nums) == 2:
            return nums[0], nums[1], None

    candidates = [
        nums[0] for _, nums in hits
        if nums and abs(nums[0]) > 1000
    ]
    if not candidates:
        candidates = [
            nums[0] for _, nums in hits
            if nums and abs(nums[0]) > 100
        ]

    if not candidates:
        return None, None, None

    unique = _deduplicate_values(candidates)

    if len(unique) >= 3:
        return unique[0], unique[1], unique[2]
    elif len(unique) == 2:
        return unique[0], unique[1], None
    else:
        v = unique[0]
        return v, v, v


