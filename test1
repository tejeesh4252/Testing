def _extract_fund_name(full_text, filename):
    patterns = [
        r'^([^\n]{5,60}(?:LP|L\.P\.|LLC|Fund|Partners)'
        r'[^\n]{0,30})\n',
        r'Fund[:\s]+([^\n]{5,60})',
        r'^([A-Z][^\n]{5,60}(?:LP|L\.P\.|LLC))',
    ]
    for p in patterns:
        match = re.search(
            p, full_text, re.IGNORECASE | re.MULTILINE
        )
        if match:
            name = match.group(1).strip()
            skip = ['portfolio advisors', 'statement',
                    'capital account', 'investor']
            if not any(s in name.lower() for s in skip):
                return name[:100]
    name  = filename.replace('.pdf', '').replace('.PDF', '')
    parts = name.split(' - ')
    for part in reversed(parts):
        part = part.strip()
        if (part and 'PASA' not in part
                and 'CAB' not in part
                and len(part) > 5):
            return part[:80]
    return name[:80]


def _extract_investor_name(full_text):
    patterns = [
        r'(?:Partner|Investor)[:\s]+'
        r'(Portfolio Advisors[^\n]{5,80})',
        r'(Portfolio Advisors Secondary Aggregator[^\n]{5,50})',
        r'(Portfolio Advisors[^\n]{5,80})',
    ]
    for p in patterns:
        match = re.search(p, full_text, re.IGNORECASE)
        if match:
            return re.sub(
                r'\s+', ' ', match.group(1).strip()
            )[:150]
    return ""


def _extract_report_date(full_text):
    _MONTH_PAT = (
        r'(?:January|February|March|April|May|June|'
        r'July|August|September|October|November|December)'
    )
    patterns = [
        # "For the year/period ended <Month> DD, YYYY"
        rf'For the.*?[Ee]nded\s+({_MONTH_PAT}\s+\d{{1,2}},\s+\d{{4}})',
        # "As of / As Of <Month> DD, YYYY"
        rf'(?:As of|As Of)\s+({_MONTH_PAT}\s+\d{{1,2}},\s+\d{{4}})',
        # "Period / Year ... MM/DD/YYYY"
        r'(?:Period|Year).*?(\d{1,2}/\d{1,2}/\d{4})',
        # bare "<Month> DD, YYYY"
        rf'({_MONTH_PAT}\s+\d{{1,2}},\s+\d{{4}})',
        # bare MM/DD/YYYY
        r'(\d{1,2}/\d{1,2}/\d{4})',
    ]
    for p in patterns:
        match = re.search(p, full_text, re.IGNORECASE)
        if match:
            # group(1) for capturing patterns; group(0) for bare fallbacks
            return (match.group(1) or match.group(0)).strip()
    return None          # ← was: "December 31, 2025"


def _clean_number(value_str):
    if not value_str:
        return None
    s = str(value_str).strip()
    if s in ['-', '--', '–', '—', '$-', '$ -', '']:
        return 0.0
    is_negative = '(' in s and ')' in s
    s = re.sub(r'[\$,\s]', '', s)
    s = s.replace('(', '').replace(')', '')
    try:
        return -float(s) if is_negative else float(s)
    except ValueError:
        return None


