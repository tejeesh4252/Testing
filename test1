def _rejoin_broken_numbers(text):
    """Fix pdfplumber space-insertion inside numbers."""
    fixed = text
    while True:
        def _try_rejoin(m):
            left   = m.group(1)
            right  = m.group(2)
            digits = len(left.replace(',', '') + right)
            if digits > 15:
                return m.group(0)
            return left + right

        new = re.sub(
            r'(\d{1,3}(?:,\d{3})*,\d+)\s+(\d{1,2})'
            r'(?=[\s,$)]|$)',
            _try_rejoin,
            fixed
        )
        if new == fixed:
            break
        fixed = new
    return fixed


def _extract_numbers(line):
    """
    Extract numeric values from a line.
    Pre-processing: em/en-dash, double-dash,
    targeted space-dash-space -> 0.
    Filters: years 2000-2030, values > $500B.
    """
    line = re.sub(r'(?<!\w)[—–](?!\w)', ' 0 ', line)
    line = re.sub(r'(?<!\w)--(?!\w)', ' 0 ', line)
    line = re.sub(r'(?<=\s)-(?=\s\d)', ' 0 ', line)

    line    = _rejoin_broken_numbers(line)
    pattern = r'\([\d,]+(?:\.\d+)?\)|-?[\d,]+(?:\.\d+)?'
    matches = re.findall(pattern, line)
    numbers = []
    for m in matches:
        is_neg = m.startswith('(') and m.endswith(')')
        clean  = re.sub(r'[()\s,]', '', m)
        try:
            val = float(clean)
            if 2000.0 <= val <= 2030.0 and '.' not in m:
                continue
            if abs(val) > 500_000_000_000:
                continue
            numbers.append(-val if is_neg else val)
        except ValueError:
            continue
    return numbers


