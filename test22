import re


def extract(full_text, filename):
    """
    Extractor for Brockton Capital Fund III format.

    Structure: Fund Performance Summary (FundMagic XML wrapper)
    Two sections:
    1. Reconciliation of Limited Partners' Capital
    2. Reconciliation of Net Asset Value

    Columns: Quarter to 31 December | Inception to 31 December
    Currency: GBP
    """
    result = {
        "Extraction Status": "SUCCESS",
        "Extraction Notes": "",
        "Template Used": "Brockton",
        "Currency": "GBP",
    }

    try:
        result["Fund Name"]     = _extract_fund_name(
            full_text, filename
        )
        result["Investor Name"] = _extract_investor_name(
            full_text
        )
        result["Report Date"]   = _extract_report_date(
            full_text
        )

        # ── Commitment ─────────────────────────────────────────
        result["Capital Commitment"] = _extract_labeled_value(
            full_text,
            [r'Total commitments\s+([\d,]+)']
        )
        result["Unfunded Commitment"] = _extract_labeled_value(
            full_text,
            [r'Amount not yet drawn down\s+([\d,]+)']
        )

        # ── LP section only ────────────────────────────────────
        # The page shows LP column first then Fund column
        # We extract the LP (left) column = first number on each row

        result["Beginning Balance QTD"] = _extract_row(
            full_text,
            ["Net Asset Value at start of period"],
            col=0
        )

        result["Contributions QTD"] = _extract_row(
            full_text,
            ["Amounts contributed"],
            col=0
        )

        result["Distributions QTD"] = _extract_row(
            full_text,
            ["Distributions to Partners"],
            col=0
        )

        result["Net Investment Income QTD"] = _extract_row(
            full_text,
            ["Investment income", "Bank interest"],
            col=0
        )

        result["Management Fees QTD"] = _extract_row(
            full_text,
            ["Other expenses"],
            col=0
        )

        result["Net Unrealized Gain/Loss QTD"] = _extract_row(
            full_text,
            ["Unrealised capital", "Unrealized capital"],
            col=0
        )

        result["Ending Balance QTD"] = _extract_row(
            full_text,
            ["Net Asset Value before Revaluation",
             "Net Assets Value after Revaluation",
             "Net Asset Value"],
            col=0
        )

        # ── ITD = LP Inception to 30 June column (col=1) ───────
        result["Contributions ITD"] = _extract_row(
            full_text,
            ["Amounts contributed"],
            col=1
        )
        result["Distributions ITD"] = _extract_row(
            full_text,
            ["Distributions to Partners"],
            col=1
        )
        result["Net Investment Income ITD"] = _extract_row(
            full_text,
            ["Bank interest"],
            col=1
        )
        result["Management Fees ITD"] = _extract_row(
            full_text,
            ["Other expenses"],
            col=1
        )
        result["Net Realized Gain/Loss ITD"] = _extract_row(
            full_text,
            ["Realised capital gains"],
            col=1
        )
        result["Ending Balance ITD"] = _extract_row(
            full_text,
            ["Net Asset Value before Revaluation",
             "Net Assets Value after Revaluation",
             "Net Asset Value"],
            col=1
        )

        result["Ending Balance ITD"] = result["Ending Balance QTD"]
        result["Ending Balance YTD"] = result["Ending Balance QTD"]

    except Exception as e:
        result["Extraction Status"] = "ERROR"
        result["Extraction Notes"]  = str(e)
        return result

    result = _validate_result(result)
    return result

def _extract_positional(line):
    """
    Parse a Brockton row into positional column values.

    Tokens are either:
      - A dash placeholder '-' or '--'  → None
      - A number like 1,276,612         → float
      - A negative in parens (311)      → negative float

    Returns a list where position matches column index.
    Year tokens (2000-2030) are skipped to avoid
    header years being counted as values.

    Example:
      'Amounts contributed - 2,707,975 - 1,151,567,944'
      → [None, 2707975.0, None, 1151567944.0]

      'Other expenses (311) (126,296) (116,471) (47,272,178)'
      → [-311.0, -126296.0, -116471.0, -47272178.0]

      'Net Asset Value at start of period 1,276,612 - ...'
      → [1276612.0, None, ...]
    """
    # Tokenise: find all dash placeholders and numeric tokens
    token_pattern = (
        r'\([\d,]+(?:\.\d+)?\)'   # negative in parens
        r'|-{1,2}(?=\s|$)'        # dash placeholder
        r'|-?[\d,]+(?:\.\d+)?'    # plain number
    )
    tokens = re.findall(token_pattern, line)
    values = []
    for t in tokens:
        t = t.strip()
        if re.fullmatch(r'-{1,2}', t):
            # Dash = positional placeholder → None
            values.append(None)
        elif t.startswith('(') and t.endswith(')'):
            clean = re.sub(r'[()\s,]', '', t)
            try:
                val = float(clean)
                # Skip year tokens
                if 2000.0 <= val <= 2030.0:
                    continue
                values.append(-val)
            except ValueError:
                continue
        else:
            clean = re.sub(r'[\s,]', '', t)
            try:
                val = float(clean)
                # Skip year tokens
                if 2000.0 <= val <= 2030.0:
                    continue
                values.append(val)
            except ValueError:
                continue
    return values


def _extract_row(text, labels, col=0):
    """
    Extract value from labelled row respecting column position.

    Brockton has 4 columns:
      col 0 = LP Quarter to 30 June  (QTD)
      col 1 = LP Inception to 30 June (ITD)
      col 2 = Fund Quarter  (ignored)
      col 3 = Fund Inception (ignored)

    Dashes (-) are positional placeholders — they must be
    counted as None so column positions are preserved.
    Without this, a dash in col 0 causes col 1 value to
    be returned as col 0.
    """
    lines = text.split('\n')
    for label in labels:
        for i, line in enumerate(lines):
            if label.lower() not in line.lower():
                continue
            # Build combined window (label line + up to 3 next)
            combined = line
            for j in range(1, 4):
                if i + j < len(lines):
                    combined += ' ' + lines[i + j]
            # Parse positional tokens — treat '-' as None
            values = _extract_positional(combined)
            if len(values) > col:
                return values[col]
    return None


def _extract_labeled_value(text, patterns):
    for pattern in patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            return _clean_number(match.group(1))
    return None


def _extract_numbers(line):
    pattern = r'\([\d,]+(?:\.\d+)?\)|-?[\d,]+(?:\.\d+)?'
    matches = re.findall(pattern, line)
    numbers = []
    for m in matches:
        is_neg = m.startswith('(') and m.endswith(')')
        clean  = re.sub(r'[()\s,]', '', m)
        try:
            val = float(clean)
            if 2000.0 <= val <= 2030.0 and '.' not in m:
                continue
            numbers.append(-val if is_neg else val)
        except ValueError:
            continue
    return numbers


def _extract_fund_name(full_text, filename):
    match = re.search(
        r'BROCKTON CAPITAL FUND[^\n]{0,20}',
        full_text, re.IGNORECASE
    )
    if match:
        return match.group(0).strip()[:100]
    name  = filename.replace('.pdf', '').replace('.PDF', '')
    parts = name.split(' - ')
    return parts[1].strip() if len(parts) >= 2 else name[:80]


def _extract_investor_name(full_text):
    match = re.search(
        r'(?:prepared for|Unaudited.*?prepared for)[:\s]+'
        r'(Portfolio Advisors[^\n]{5,80})',
        full_text, re.IGNORECASE
    )
    if match:
        return re.sub(
            r'\s+', ' ', match.group(1).strip()
        )[:150]
    match = re.search(
        r'(Portfolio Advisors[^\n]{5,80})',
        full_text, re.IGNORECASE
    )
    if match:
        return re.sub(
            r'\s+', ' ', match.group(1).strip()
        )[:150]
    return ""


def _extract_report_date(full_text):
    match = re.search(
        r'(\d{1,2}/\d{1,2}/\d{4})',
        full_text, re.IGNORECASE
    )
    if match:
        return match.group(1).strip()
    return "31/12/2025"


def _clean_number(value_str):
    if not value_str:
        return None
    s = str(value_str).strip()
    if s in ['-', '--', '–', '—', '$-', '$ -', '']:
        return 0.0
    is_negative = '(' in s and ')' in s
    s = re.sub(r'[\$,\s]', '', s)
    s = s.replace('(', '').replace(')', '')
    try:
        return -float(s) if is_negative else float(s)
    except ValueError:
        return None


def _validate_result(result):
    notes = []
    has_ending = any([
        result.get("Ending Balance QTD"),
        result.get("Ending Balance YTD"),
        result.get("Ending Balance ITD"),
    ])
    has_beginning = any([
        result.get("Beginning Balance QTD"),
        result.get("Beginning Balance YTD"),
        result.get("Beginning Balance ITD"),
    ])
    if not has_ending:
        notes.append("Missing ending balance")
        result["Extraction Status"] = "PARTIAL"
    elif not has_beginning:
        notes.append("Missing beginning balance")
        result["Extraction Status"] = "PARTIAL"
    else:
        result["Extraction Status"] = "SUCCESS"
    result["Extraction Notes"] = " | ".join(notes)
    return result
