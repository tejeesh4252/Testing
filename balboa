class SmartMapper:

    def __init__(self):
        self.training_data = []
        self.corrections   = {}
        self.load_config()
        self.init_db()

    def load_config(self):
        if os.path.exists(CONFIG_FILE):
            with open(CONFIG_FILE, 'r') as f:
                self.config = json.load(f)
        else:
            self.config = {
                'high_threshold':   85,
                'medium_threshold': 70
            }

    def init_db(self):
        conn = sqlite3.connect(DB_FILE)
        c    = conn.cursor()
        c.execute('''
            CREATE TABLE IF NOT EXISTS corrections (
                id            INTEGER PRIMARY KEY AUTOINCREMENT,
                description   TEXT,
                gl_code       TEXT,
                gl_name       TEXT,
                corrected_at  TEXT
            )
        ''')
        c.execute('''
            CREATE TABLE IF NOT EXISTS transaction_history (
                id                INTEGER PRIMARY KEY AUTOINCREMENT,
                fund_name         TEXT,
                property_code     TEXT,
                sheet_name        TEXT,
                bank_name         TEXT,
                account_number    TEXT,
                trans_date        TEXT,
                post_month        TEXT,
                amount            REAL,
                bank_desc         TEXT,
                bank_desc2        TEXT,
                yardi_offset_acct TEXT,
                gl_code_cash      TEXT,
                archived_on       TEXT,
                source_month      TEXT
            )
        ''')
        c.execute('CREATE INDEX IF NOT EXISTS idx_bank_desc    ON transaction_history(bank_desc)')
        c.execute('CREATE INDEX IF NOT EXISTS idx_offset_acct  ON transaction_history(yardi_offset_acct)')
        c.execute('CREATE INDEX IF NOT EXISTS idx_source_month ON transaction_history(source_month)')
        conn.commit()
        conn.close()

    def load_training_data(self, filepath):
        try:
            xl       = pd.ExcelFile(filepath)
            all_data = []
            for sheet in xl.sheet_names:
                try:
                    df = pd.read_excel(filepath, sheet_name=sheet, dtype=str)
                    df.columns = [str(c).strip() for c in df.columns]
                    desc_col = next(
                        (c for c in df.columns
                         if c.lower() in ['je comments', 'description',
                                          'transaction description',
                                          'combined_desc']),
                        None
                    )
                    gl_col   = next(
                        (c for c in df.columns
                         if c.lower() in ['yardi account #', 'gl code',
                                          'gl_code', 'mapped_gl']),
                        None
                    )
                    name_col = next(
                        (c for c in df.columns
                         if c.lower() in ['yardi account name', 'gl name',
                                          'gl_name', 'mapped_name']),
                        None
                    )
                    if desc_col and gl_col:
                        for _, row in df.iterrows():
                            desc = str(row.get(desc_col, '')).strip()
                            gl   = str(row.get(gl_col,   '')).strip()
                            name = str(row.get(name_col, '')).strip() if name_col else ''
                            if (desc and gl
                                    and desc not in ('nan', '')
                                    and gl   not in ('nan', '')):
                                all_data.append((desc, gl, name))
                except Exception:
                    continue
            self.training_data = all_data
            return len(all_data)
        except Exception as e:
            print(f"Training load error: {e}")
            return 0

    def load_corrections(self):
        conn = sqlite3.connect(DB_FILE)
        c    = conn.cursor()
        c.execute('SELECT description, gl_code, gl_name FROM corrections')
        rows = c.fetchall()
        conn.close()
        self.corrections = {r[0].lower(): (r[1], r[2]) for r in rows}

    def save_correction(self, description, gl_code, gl_name):
        conn = sqlite3.connect(DB_FILE)
        c    = conn.cursor()
        c.execute('''
            INSERT INTO corrections (description, gl_code, gl_name, corrected_at)
            VALUES (?, ?, ?, ?)
        ''', (description.lower(), gl_code, gl_name,
              datetime.now().strftime('%Y-%m-%d %H:%M:%S')))
        conn.commit()
        conn.close()
        self.corrections[description.lower()] = (gl_code, gl_name)

    def find_best_match(self, description):
        if not description:
            return None, None, 0, 'LOW'

        desc_lower = description.lower()

        # 1. exact correction
        if desc_lower in self.corrections:
            gl, name = self.corrections[desc_lower]
            return gl, name, 100, 'HIGH'

        # 2. fuzzy match
        if not self.training_data:
            return None, None, 0, 'LOW'

        best_score  = 0
        best_gl     = None
        best_name   = None

        for train_desc, gl, name in self.training_data:
            score = fuzz.token_sort_ratio(desc_lower, train_desc.lower())
            if score > best_score:
                best_score = score
                best_gl    = gl
                best_name  = name

        high = self.config.get('high_threshold',   85)
        med  = self.config.get('medium_threshold', 70)

        if best_score >= high:
            conf = 'HIGH'
        elif best_score >= med:
            conf = 'MEDIUM'
        else:
            conf = 'LOW'

        return best_gl, best_name, best_score, conf

    def get_db_stats(self):
        conn = sqlite3.connect(DB_FILE)
        c    = conn.cursor()
        c.execute("SELECT COUNT(*) FROM transaction_history")
        total = c.fetchone()[0]
        c.execute("SELECT COUNT(DISTINCT source_month) FROM transaction_history")
        months = c.fetchone()[0]
        c.execute("SELECT COUNT(DISTINCT fund_name) FROM transaction_history")
        funds = c.fetchone()[0]
        c.execute("SELECT COUNT(DISTINCT yardi_offset_acct) "
                  "FROM transaction_history WHERE yardi_offset_acct!=''")
        accts = c.fetchone()[0]
        c.execute("SELECT MIN(trans_date), MAX(trans_date) FROM transaction_history")
        dr = c.fetchone()
        conn.close()
        return {
            'total':    total,
            'months':   months,
            'funds':    funds,
            'accts':    accts,
            'earliest': dr[0] or 'N/A',
            'latest':   dr[1] or 'N/A'
        }

    def archive_transactions(self, transactions, fund_name, source_month):
        property_code = FUND_PROPERTY_MAP.get(fund_name, '')
        conn          = sqlite3.connect(DB_FILE)
        c             = conn.cursor()
        inserted = skipped = 0
        for txn in transactions:
            if txn.get('status') == 'SKIP':
                continue
            trans_date = str(txn.get('date', ''))
            bank_desc  = str(txn.get('bank_desc',  ''))
            amount     = txn.get('amount', 0)
            c.execute(
                "SELECT id FROM transaction_history "
                "WHERE fund_name=? AND trans_date=? AND bank_desc=? AND amount=?",
                (fund_name, trans_date, bank_desc, amount)
            )
            if c.fetchone():
                skipped += 1
                continue
            c.execute('''
                INSERT INTO transaction_history
                    (fund_name, property_code, sheet_name, bank_name,
                     account_number, trans_date, post_month, amount,
                     bank_desc, bank_desc2, yardi_offset_acct,
                     gl_code_cash, archived_on, source_month)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            ''', (
                fund_name, property_code,
                txn.get('sheet',         ''),
                txn.get('bank_name',     ''),
                txn.get('account_number',''),
                trans_date,
                txn.get('post_month',   ''),
                amount,
                bank_desc,
                str(txn.get('bank_desc2',  '')),
                str(txn.get('mapped_gl',   '')),
                str(txn.get('bank_gl',     '')),
                datetime.now().strftime('%Y-%m-%d'),
                source_month
            ))
            inserted += 1
        conn.commit()
        conn.close()
        return inserted, skipped


