    def export_etl(self):
        if not self.transactions:
            messagebox.showwarning("No Data", "No transactions to export.")
            return

        ready  = [t for t in self.transactions
                  if t.get('mapped_gl') and t.get('status') != 'SKIP']
        manual = [t for t in self.transactions
                  if not t.get('mapped_gl') and t.get('status') != 'SKIP']

        if manual:
            ans = messagebox.askyesno(
                "Unmapped Transactions",
                f"⚠️  {len(manual)} transaction(s) have no GL code.\n\n"
                f"Export the {len(ready)} mapped transactions only?\n"
                "(Unmapped rows will be skipped)"
            )
            if not ans:
                return

        fund = self.current_fund.get()
        fp   = filedialog.asksaveasfilename(
            title="Save Yardi ETL File",
            defaultextension=".xlsx",
            filetypes=[("Excel files", "*.xlsx")],
            initialfile=(
                f"Yardi_ETL_"
                f"{fund.replace(' ', '_')}_"
                f"{datetime.now().strftime('%Y%m%d')}.xlsx"
            )
        )
        if not fp:
            return

        ok, msg = self.exporter.export(ready, fund, fp)
        if ok:
            messagebox.showinfo("Export Complete", f"✅  {msg}\n\nSaved to:\n{fp}")
            self._set_status(f"✅ Exported → {fp}")
        else:
            messagebox.showerror("Export Failed", msg)

