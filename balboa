        def _load_tx_months():
            try:
                conn = sqlite3.connect(DB_FILE)
                c    = conn.cursor()
                c.execute("SELECT DISTINCT source_month FROM transaction_history "
                          "WHERE source_month IS NOT NULL ORDER BY source_month DESC")
                months = ['All'] + [r[0] for r in c.fetchall() if r[0]]
                conn.close()
                _tx_month_cb['values'] = months
            except Exception:
                pass

        def _refresh_tx(*_):
            fund   = _tx_fund_var.get()
            month  = _tx_month_var.get()
            search = _tx_search_var.get().strip().lower()
            try:
                conn   = sqlite3.connect(DB_FILE)
                c      = conn.cursor()
                query  = ("SELECT id, fund_name, sheet_name, bank_name, account_number, "
                          "trans_date, post_month, amount, bank_desc, bank_desc2, "
                          "yardi_offset_acct, gl_code_cash, archived_on, source_month "
                          "FROM transaction_history WHERE 1=1")
                params = []
                if fund != 'All':
                    query += " AND fund_name = ?"
                    params.append(fund)
                if month != 'All':
                    query += " AND source_month = ?"
                    params.append(month)
                query += " ORDER BY trans_date DESC"
                c.execute(query, params)
                rows = c.fetchall()
                conn.close()
            except Exception as e:
                messagebox.showerror("DB Error", str(e), parent=win)
                return
            if search:
                rows = [r for r in rows
                        if any(search in str(cell).lower() for cell in r)]
            tx_tree.delete(*tx_tree.get_children())
            for i, row in enumerate(rows):
                tag  = 'odd' if i % 2 else 'even'
                vals = list(row)
                tx_tree.insert('', 'end', values=vals, tags=(tag,))

        def _delete_tx_row():
            sel = tx_tree.selection()
            if not sel:
                return
            row_id = tx_tree.item(sel[0])['values'][0]
            if not messagebox.askyesno("Confirm Delete",
                                       f"Delete transaction ID {row_id}?",
                                       parent=win):
                return
            try:
                conn = sqlite3.connect(DB_FILE)
                conn.execute("DELETE FROM transaction_history WHERE id=?", (row_id,))
                conn.commit()
                conn.close()
                _refresh_tx()
                self._refresh_db_stat()
            except Exception as e:
                messagebox.showerror("DB Error", str(e), parent=win)

