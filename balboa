    def run_mapping(self):
        if not self.transactions:
            messagebox.showwarning("No Data", "Please upload a monthly file first.")
            return
        if not self.training_loaded:
            messagebox.showwarning("No Training Data",
                                   "Please load the master training file first.")
            return
        self._set_status("Running auto-mapping…")
        high = med = low = existing = 0
        for txn in self.transactions:
            if txn.get('existing_gl'):
                txn['mapped_gl']   = txn['existing_gl']
                txn['mapped_name'] = txn.get('existing_name', '')
                txn['score']       = 100
                txn['confidence']  = 'HIGH'
                txn['status']      = 'EXISTING'
                existing += 1
                continue
            desc = txn.get('combined_desc', '')
            gl, name, score, conf = self.mapper.find_best_match(desc)
            txn['mapped_gl']   = gl   or ''
            txn['mapped_name'] = name or ''
            txn['score']       = score
            txn['confidence']  = conf
            txn['status']      = 'MAPPED' if gl else 'UNMAPPED'
            if conf == 'HIGH':
                high += 1
            elif conf == 'MEDIUM':
                med  += 1
            else:
                low  += 1
        self._sv_high.set(str(high + existing))
        self._sv_medium.set(str(med))
        self._sv_low.set(str(low))
        self._populate_table(show_mapping=True)
        self._set_status(
            f"✅ Mapping complete  │  "
