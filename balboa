        def _log(msg):
            log_box.insert(tk.END, msg + "\n")
            log_box.see(tk.END)
            log_box.update()

        def _run_import_thread():
            fund_key      = import_fund_var.get()
            fund_cfg      = FUND_CONFIGS[fund_key]
            source_path   = self._import_source_file
            cashbook_path = self._import_cashbook_file

            run_btn.config(state='disabled', text="⏳  IMPORTING…")

            try:
                _log("=" * 52)
                _log(f"IMPORT STARTED  —  {fund_key}")
                _log("=" * 52)
                _log(f"Source  : {os.path.basename(source_path)}")
                _log(f"Cashbook: {os.path.basename(cashbook_path)}")

                _log("\nReading source file…")
                df = pd.read_excel(source_path, sheet_name=0, header=None)
                _log(f"Loaded  : {len(df)} rows, {len(df.columns)} cols")

                df = pd.read_excel(source_path, sheet_name=0, header=None)
                _log(f"Loaded  : {len(df)} rows, {len(df.columns)} cols")

                _log("\n🔍 Checking date compatibility…")
                f_early, f_late = _get_earliest_date_from_file(df)
                c_early, c_late = _get_date_range_from_cashbook(
                    cashbook_path, fund_cfg['sheet_mapping']
                )

                if f_early:
                    _log(f"Source date range : {f_early.date()} → {f_late.date()}")
                if c_early:
                    _log(f"Cashbook date range: {c_early.date()} → {c_late.date()}")

                # Identify bank account sections
                _log("\nIdentifying account sections…")
                accounts = _identify_account_sections(
                    df, fund_cfg['bank_normalization']
                )

                if not accounts:
                    _log("❌ No account sections found!")
                    win.after(0, lambda: messagebox.showerror(
                        "Error", "No account sections found in file.",
                        parent=win
                    ))
                    return

                _log(f"Found {len(accounts)} account(s)")
                for acc in accounts:
                    # Use the keys set by _identify_account_sections: 'bank', 'account_no'
                    key = (f"{acc['bank_name']}_"
                           f"{acc['account_number'].replace('-', '').replace(' ', '')}")
                    acc['sheet_name'] = fund_cfg['sheet_mapping'].get(key, key)
                    _log(f"  {acc['bank_name']} {acc['account_number']} "
                         f"→ {acc['sheet_name']}")

                # Process each account
                _log("\nProcessing accounts…")
                total_added   = 0
                total_skipped = 0

                for acc in accounts:
                    _log(f"\n── {acc['bank_name']} {acc['account_number']} ──")
                    data, stats = _extract_account_data(df, acc, _log)

                    if data.empty:
                        _log("  No data found")
                        continue

                    added, skipped = _append_to_cashbook(
                        data,
                        acc['sheet_name'],
                        cashbook_path,
                        _log
                    )
                    total_added   += added
                    total_skipped += skipped

                # Summary
                _log("\n" + "=" * 52)
                _log("IMPORT COMPLETE")
                _log("=" * 52)
                _log(f"  Rows imported  : {total_added}")
                _log(f"  Duplicates     : {total_skipped}")

                win.after(0, self._refresh_db_stat)
                win.after(0, lambda: messagebox.showinfo(
                    "Import Complete",
                    f"✅  Import finished!\n\n"
                    f"Rows imported  : {total_added}\n"
                    f"Duplicates     : {total_skipped}",
                    parent=win
                ))

            except Exception as e:
                _log(f"\n❌ ERROR: {e}")
            finally:
                run_btn.config(state='normal', text="▶  RUN IMPORT")
                self._refresh_db_stat()

        def _start_import():
            threading.Thread(target=_run_import_thread, daemon=True).start()

