        corr_frame = tk.Frame(tab_corr, bg=BG)
        corr_frame.pack(fill='both', expand=True, padx=10, pady=10)

        corr_vsb = ttk.Scrollbar(corr_frame, orient='vertical')
        corr_hsb = ttk.Scrollbar(corr_frame, orient='horizontal')
        corr_tree = ttk.Treeview(
            corr_frame, columns=corr_cols, show='headings',
            selectmode='browse',
            yscrollcommand=corr_vsb.set, xscrollcommand=corr_hsb.set
        )
        corr_vsb.config(command=corr_tree.yview)
        corr_hsb.config(command=corr_tree.xview)

        for col, lbl, w in zip(corr_cols, corr_col_lbl, corr_col_w):
            corr_tree.heading(col, text=lbl)
            corr_tree.column(col, width=w, minwidth=40, anchor='w')

        corr_tree.tag_configure('odd',  background='#252d3d', foreground='white')
        corr_tree.tag_configure('even', background='#1e2433', foreground='white')
        corr_vsb.pack(side='right',  fill='y')
        corr_hsb.pack(side='bottom', fill='x')
        corr_tree.pack(fill='both', expand=True)

        _corr_count_lbl = tk.Label(tab_corr, text="", bg=BG, fg='#8892a4',
                                   font=('Segoe UI', 9))
        _corr_count_lbl.pack(anchor='w', padx=12, pady=(2, 0))

        def _refresh_corr():
            try:
                conn = sqlite3.connect(DB_FILE)
                c    = conn.cursor()
                c.execute("SELECT id, description, gl_code, gl_name, corrected_at "
                          "FROM corrections ORDER BY corrected_at DESC")
                rows = c.fetchall()
                conn.close()
            except Exception as e:
                messagebox.showerror("DB Error", str(e), parent=win)
                return
            corr_tree.delete(*corr_tree.get_children())
            for i, row in enumerate(rows):
                tag = 'odd' if i % 2 else 'even'
                corr_tree.insert('', 'end', iid=str(row[0]),
                                 values=row, tags=(tag,))
            _corr_count_lbl.config(text=f"{len(rows):,} corrections saved")

        def _delete_corr_row():
            sel = corr_tree.selection()
            if not sel:
                return
            row_id = int(sel[0])
            if not messagebox.askyesno("Confirm Delete",
                                       f"Delete correction ID {row_id}?",
                                       parent=win):
                return
            try:
                conn = sqlite3.connect(DB_FILE)
                conn.execute("DELETE FROM corrections WHERE id=?", (row_id,))
                conn.commit()
                conn.close()
                _refresh_corr()
            except Exception as e:
                messagebox.showerror("DB Error", str(e), parent=win)

        def _export_corr():
            rows = corr_tree.get_children()
            if not rows:
                messagebox.showwarning("No Data", "No corrections to export.",
                                       parent=win)
                return
            fp = filedialog.asksaveasfilename(
                parent=win, title="Export Corrections",
                defaultextension=".xlsx",
                filetypes=[("Excel files", "*.xlsx")],
                initialfile=f"DB_Corrections_{datetime.now().strftime('%Y%m%d')}.xlsx"
            )
            if not fp:
                return
            data = [corr_tree.item(r)['values'] for r in rows]
            df   = pd.DataFrame(data, columns=corr_col_lbl)
            try:
                df.to_excel(fp, index=False)
                messagebox.showinfo("Export Complete",
                                    f"✅ Exported {len(data):,} corrections to:\n{fp}",
                                    parent=win)
            except Exception as e:
                messagebox.showerror("Export Error", str(e), parent=win)

        corr_btn = tk.Frame(tab_corr, bg=BG)
        corr_btn.pack(fill='x', padx=10, pady=(0, 8))

        tk.Button(corr_btn, text="🔄  Refresh",
                  bg='#3b82f6', fg='white',
                  font=('Segoe UI', 9, 'bold'), padx=12, pady=4,
                  command=_refresh_corr
                  ).pack(side='left', padx=(0, 6))
        tk.Button(corr_btn, text="📤  Export to Excel",
                  bg='#00d084', fg='white',
                  font=('Segoe UI', 9, 'bold'), padx=12, pady=4,
                  command=_export_corr
                  ).pack(side='left', padx=(0, 6))
        tk.Button(corr_btn, text="🗑️  Delete Selected",
                  bg='#e74c3c', fg='white',
                  font=('Segoe UI', 9, 'bold'), padx=12, pady=4,
                  command=_delete_corr_row
                  ).pack(side='left', padx=(0, 6))

        _refresh_corr()

    # ── helper ────────────────────────────────────────────────────────────────

    @staticmethod
    def _excel_date(serial):
        try:
            dt = pd.Timestamp('1899-12-30') + pd.Timedelta(days=int(serial))
            return dt.strftime('%m/%d/%Y')
        except Exception:
            return str(serial)

    # ── table ─────────────────────────────────────────────────────────────────

    def _populate_table(self, show_mapping=False):
        self.tree.delete(*self.tree.get_children())
        for i, txn in enumerate(self.transactions):
            date_str = self._excel_date(txn['date'])
            amt_str  = f"{txn['amount']:,.2f}"
            if show_mapping:
                gl     = txn.get('mapped_gl',   '')
                name   = txn.get('mapped_name', '')
                score  = txn.get('score',       '')
                conf   = txn.get('confidence',  '')
                status = txn.get('status',      '')
            else:
                gl = name = score = conf = status = ''
            conf_disp = {
                'HIGH':   '✅ HIGH',
                'MEDIUM': '⚠️  MEDIUM',
                'LOW':    '❌ LOW',
            }.get(conf, conf)
            tag = conf if conf in ('HIGH', 'MEDIUM', 'LOW') else 'MANUAL'
            if status == 'EXISTING':
                tag = 'EXISTING'
            self.tree.insert(
                '', 'end', iid=str(i),
                values=(
                    txn.get('sheet', ''), date_str, amt_str,
                    txn.get('combined_desc', ''),
                    gl, name, conf_disp,
                    f"{score}%" if score != '' else '',
                    status,
                ),
                tags=(tag,)
            )

    # ── correction dialog ─────────────────────────────────────────────────────

    def _on_double_click(self, _event):
        sel = self.tree.selection()
        if not sel:
            return
        idx = int(sel[0])
        self._open_correction_dialog(idx, self.transactions[idx])

    def _open_correction_dialog(self, idx, txn):
        BG   = '#1e2433'
        CARD = '#252d3d'

        dlg = tk.Toplevel(self.root)
        dlg.title("Correct GL Mapping")
        dlg.geometry("540x480")
        dlg.configure(bg=BG)
        dlg.grab_set()

        tk.Label(dlg, text="✏️  Correct GL Mapping",
                 bg=BG, fg='white',
                 font=('Segoe UI', 13, 'bold')).pack(pady=(15, 5))
        tk.Label(dlg,
                 text=f"Description:  {txn.get('combined_desc', '')}",
                 bg=BG, fg='#8892a4',
                 font=('Segoe UI', 9), wraplength=490, justify='left'
                 ).pack(padx=20, anchor='w')
        tk.Label(dlg,
                 text=(f"Current GL:   "
                       f"{txn.get('mapped_gl', 'None')}  –  "
                       f"{txn.get('mapped_name', 'Not mapped')}"),
                 bg=BG, fg='#f39c12',
                 font=('Segoe UI', 9)
                 ).pack(padx=20, anchor='w', pady=(0, 12))

        # ── Load COA from cashbook ────────────────────────────────────────
        coa_map = {}   # {gl_code: gl_name}
        try:
            fund_key  = self.current_fund.get()
            fund_cfg  = FUND_CONFIGS.get(fund_key, {})
            cb_path   = self.current_file or fund_cfg.get('cashbook', '')
            if cb_path and os.path.exists(cb_path):
                df_coa = pd.read_excel(cb_path, sheet_name='COA',
                                       dtype=str, usecols=[0, 1])
                df_coa.columns = ['Account', 'Account Name']
                df_coa         = df_coa.dropna(subset=['Account'])
                coa_map        = dict(
                    zip(df_coa['Account'].str.strip(),
                        df_coa['Account Name'].str.strip())
                )
        except Exception:
            pass   # COA unavailable — user can still type manually

        # ── GL Code entry with auto-lookup ────────────────────────────────
        tk.Label(dlg, text="New GL Code:", bg=BG, fg='white',
                 font=('Segoe UI', 10)).pack(padx=20, anchor='w')

        gl_var   = tk.StringVar(value=txn.get('mapped_gl', ''))
        name_var = tk.StringVar(value=txn.get('mapped_name', ''))

        gl_entry = tk.Entry(dlg, textvariable=gl_var,
                            font=('Segoe UI', 11),
                            bg=CARD, fg='white',
                            insertbackground='white',
                            width=30)
        gl_entry.pack(padx=20, pady=4, anchor='w')

        # Status label — shows match feedback
        match_lbl = tk.Label(dlg, text="", bg=BG,
                             font=('Segoe UI', 9))
        match_lbl.pack(padx=20, anchor='w', pady=(0, 4))

        tk.Label(dlg, text="GL Name:", bg=BG, fg='white',
                 font=('Segoe UI', 10)).pack(padx=20, anchor='w')

        name_entry = tk.Entry(dlg, textvariable=name_var,
                              font=('Segoe UI', 11),
                              bg=CARD, fg='white',
                              insertbackground='white',
                              width=40)
        name_entry.pack(padx=20, pady=4, anchor='w')

        # ── Auto-lookup on GL code change ─────────────────────────────────
        def _on_gl_change(*_):
            code = gl_var.get().strip()
            if code in coa_map:
                name_var.set(coa_map[code])
                match_lbl.config(
                    text=f"✅  Found: {coa_map[code]}",
                    fg='#00d084'
                )
            elif code:
                # Partial match — show suggestions
                suggestions = [k for k in coa_map if k.startswith(code)]
                if suggestions:
                    match_lbl.config(
                        text=f"💡  Suggestions: {', '.join(suggestions[:4])}",
                        fg='#f39c12'
                    )
                else:
                    match_lbl.config(
                        text="⚠️  GL code not found in COA",
                        fg='#e74c3c'
                    )
            else:
                match_lbl.config(text="", fg='white')

        gl_var.trace_add('write', _on_gl_change)

        # Trigger once on open in case there's a pre-filled value
        _on_gl_change()

        remember_var = tk.BooleanVar(value=True)
        tk.Checkbutton(
            dlg, text="Remember this correction for future transactions",
            variable=remember_var,
            bg=BG, fg='#8892a4', selectcolor=CARD,
            font=('Segoe UI', 9)
        ).pack(padx=20, anchor='w', pady=6)

        btn_row = tk.Frame(dlg, bg=BG)
        btn_row.pack(pady=14)

        def apply():
            new_gl   = gl_var.get().strip()
            new_name = name_var.get().strip()
            if not new_gl:
                messagebox.showwarning("Missing GL",
                                       "Please enter a GL code.", parent=dlg)
                return
            if new_gl not in coa_map and coa_map:
                if not messagebox.askyesno(
                    "GL Not in COA",
                    f"⚠️  '{new_gl}' was not found in the Chart of Accounts.\n\n"
                    f"Are you sure you want to use this GL code?",
                    parent=dlg
                ):
                    return
            self.transactions[idx]['mapped_gl']   = new_gl
            self.transactions[idx]['mapped_name'] = new_name
            self.transactions[idx]['confidence']  = 'HIGH'
            self.transactions[idx]['score']       = 100
            self.transactions[idx]['status']      = 'CORRECTED'
            if remember_var.get():
                self.mapper.save_correction(
                    txn.get('combined_desc', ''), new_gl, new_name)
            self._populate_table(show_mapping=True)
            dlg.destroy()

        def skip_row():
            self.transactions[idx]['status'] = 'SKIP'
            self._populate_table(show_mapping=True)
            dlg.destroy()

        for txt, bg_col, cmd in [
            ("✅  Apply",  '#00d084', apply),
            ("⏭  Skip",   '#95a5a6', skip_row),
            ("Cancel",     '#e74c3c', dlg.destroy),
        ]:
            tk.Button(btn_row, text=txt, bg=bg_col, fg='white',
                      font=('Segoe UI', 10, 'bold'),
                      padx=14, pady=6, command=cmd
                      ).pack(side='left', padx=8)


