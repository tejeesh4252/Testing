    def _save_gl_to_cashbook(self):
        """Write mapped GL codes back to cashbook columns E-F (Yardi GL + Name)."""
        if not self.transactions:
            messagebox.showwarning("No Data", "No transactions loaded.")
            return
        if not self.current_file:
            messagebox.showwarning("No File", "No cashbook file loaded.")
            return

        mapped = [t for t in self.transactions if t.get('mapped_gl')]
        if not mapped:
            messagebox.showwarning("No Mappings", "Run Auto-Mapping first.")
            return

        try:
            self._set_status("Saving GL mappings to cashbook…")
            wb = openpyxl.load_workbook(self.current_file)
            updated = 0

            for txn in mapped:
                sheet_name = txn.get('sheet')
                if sheet_name not in wb.sheetnames:
                    continue

                ws = wb[sheet_name]
                date_num = txn['date']
                amount = txn['amount']

                # Convert date serial to date for matching
                try:
                    txn_date = (pd.Timestamp('1899-12-30') +
                                pd.Timedelta(days=int(date_num))).date()
                except Exception:
                    continue

                # Scan rows to find matching date + amount
                for r in range(HEADER_ROWS + 1, ws.max_row + 1):
                    cell_date = ws.cell(r, 1).value
                    cell_amount = ws.cell(r, 2).value

                    if cell_date is None:
                        break

                    if isinstance(cell_date, datetime):
                        row_date = cell_date.date()
                    else:
                        continue

                    try:
                        row_amount = float(cell_amount)
                    except (TypeError, ValueError):
                        continue

                    if row_date == txn_date and abs(row_amount - amount) < 0.01:
                        # Col E (5) = Yardi GL Offset Account
                        # Col F (6) = Yardi Account Description
                        ws.cell(r, 6).value = txn.get('mapped_gl', '')
                        ws.cell(r, 7).value = txn.get('mapped_name', '')
                        updated += 1
                        break

            wb.save(self.current_file)
            wb.close()

            self._set_status(f"✅ Saved {updated} GL mappings to cashbook.")
            messagebox.showinfo("Saved",
                                f"✅ {updated} GL mappings written to:\n"
                                f"{os.path.basename(self.current_file)}")

        except Exception as e:
            messagebox.showerror("Error", str(e))
            self._set_status("❌ Save GL failed.")

    def _archive_month(self):
        """
        Append current month's mapped transactions to the master training file.
        Columns written: Date, Amount, Bank Description, Bank Description 2,
                         Combined Desc (JE Comments), Yardi Account #, Yardi Account Name
        """
        if not self.transactions:
            messagebox.showwarning("No Data", "No transactions loaded.")
            return

        mapped = [t for t in self.transactions
                  if t.get('mapped_gl') and t.get('status') != 'SKIP']
        if not mapped:
            messagebox.showwarning("Nothing to Archive",
                                   "No mapped transactions found.\n"
                                   "Run Auto-Mapping and review first.")
            return

        # Ask user where the master training file is
        fp = filedialog.asksaveasfilename(
            title="Select / Create Master Training File",
            defaultextension=".xlsx",
            filetypes=[("Excel files", "*.xlsx")],
            initialfile="Balboa_Master_Training.xlsx"
        )
        if not fp:
            return

        try:
            self._set_status("Archiving to training file…")

            # Load existing or create new
            if os.path.exists(fp):
                wb = openpyxl.load_workbook(fp)
            else:
                wb = openpyxl.Workbook()
                wb.remove(wb.active)  # remove default empty sheet

            # Sheet name = current month  e.g. "2026-06"
            try:
                sample_date = (pd.Timestamp('1899-12-30') +
                               pd.Timedelta(days=int(mapped[0]['date'])))
                sheet_name = sample_date.strftime('%Y-%m')
            except Exception:
                sheet_name = datetime.now().strftime('%Y-%m')

            # Create sheet (or clear if exists)
            if sheet_name in wb.sheetnames:
                del wb[sheet_name]
            ws = wb.create_sheet(sheet_name)

            # Write header
            headers = [
                'Post Date', 'Transaction Amount',
                'Transaction Description', 'Transaction Description 2',
                'JE comments',
                'Yardi Account #', 'Yardi Account name'
            ]
            for col, h in enumerate(headers, start=1):
                ws.cell(1, col).value = h

            # Write rows
            written = 0
            for txn in mapped:
                try:
                    dt = (pd.Timestamp('1899-12-30') +
                          pd.Timedelta(days=int(txn['date']))).strftime('%m/%d/%Y')
                except Exception:
                    dt = str(txn['date'])

                ws.cell(written + 2, 1).value = dt
                ws.cell(written + 2, 2).value = txn.get('amount', '')
                ws.cell(written + 2, 3).value = txn.get('bank_desc', '')
                ws.cell(written + 2, 4).value = txn.get('bank_desc2', '')
                ws.cell(written + 2, 5).value = txn.get('combined_desc', '')
                ws.cell(written + 2, 6).value = txn.get('mapped_gl', '')
                ws.cell(written + 2, 7).value = txn.get('mapped_name', '')
                written += 1

            wb.save(fp)
            wb.close()

            # Also archive to DB
            fund = self.current_fund.get()
            source_month = sheet_name
            ins, skp = self.mapper.archive_transactions(
                self.transactions, fund, source_month)

            self._set_status(
                f"✅ Archived {written} rows to training file  │  "
                f"DB: {ins} inserted, {skp} skipped"
            )
            messagebox.showinfo(
                "Archive Complete",
                f"✅ {written} transactions written to:\n"
                f"{os.path.basename(fp)}\n\n"
                f"Sheet: {sheet_name}\n"
                f"DB records inserted: {ins}\n\n"
                f"Load this file as Training Data next month for better matching."
            )
            self._refresh_db_stat()

        except Exception as e:
            messagebox.showerror("Archive Error", str(e))
            self._set_status("❌ Archive failed.")

