class ETLExporter:

    def export(self, mapped_transactions, fund_name, output_path):
        property_code = FUND_PROPERTY_MAP.get(fund_name, 'brf1')
        rows = []

        # --- Group transactions by date first ---
        from collections import defaultdict
        transactions_by_date = defaultdict(list)

        for txn in mapped_transactions:
            if txn.get('status') == 'SKIP':
                continue
            if not txn.get('mapped_gl') or not txn.get('bank_gl'):
                continue

            date_val = txn['date']
            try:
                dt = pd.Timestamp('1899-12-30') + pd.Timedelta(days=int(date_val))
                date_str = dt.strftime('%m/%d/%Y')
                post_mon = dt.replace(day=1).strftime('%Y-%m')   # kept as string, converted to date in formatter
                date_key = dt.date()
            except Exception:
                date_str = str(date_val)
                post_mon = ''
                date_key = date_val

            transactions_by_date[date_key].append({
                'date_str': date_str,
                'post_mon': post_mon,
                'amount': txn['amount'],
                'bank_gl': txn['bank_gl'],
                'offset_gl': txn['mapped_gl'],
                'detail_note': txn.get('combined_desc', ''),
            })

        if not transactions_by_date:
            return False, "No transactions to export"

        # --- One TRANNUM per unique date ---
        sorted_dates = sorted(transactions_by_date.keys())

        for tran_num, date_key in enumerate(sorted_dates, start=1):
            tran_str =  tran_num
            for txn in transactions_by_date[date_key]:
                rows.append([tran_str, txn['date_str'], property_code, txn['bank_gl'],
                             txn['post_mon'], BOOKNUM, txn['amount'], txn['detail_note'],
                             '', ''])
                rows.append([tran_str, txn['date_str'], property_code, txn['offset_gl'],
                             txn['post_mon'], BOOKNUM, -txn['amount'], txn['detail_note'],
                             '', ''])

        df_out = pd.DataFrame(rows, columns=[
            'TRANNUM', 'DATE', 'PROPERTY', 'ACCOUNT',
            'POSTMONTH', 'BOOKNUM', 'AMOUNT',
            'REMARK', 'REF', 'DETAILNOTES'
        ])

        try:
            with pd.ExcelWriter(output_path, engine='openpyxl') as writer:
                pd.DataFrame([['FinJournals']]).to_excel(
                    writer, sheet_name='ETL Export',
                    index=False, header=False
                )
                df_out.to_excel(
                    writer, sheet_name='ETL Export',
                    index=False, startrow=1
                )

            # ── Post-process formatting ───────────────────────────────────
            from openpyxl import load_workbook
            from openpyxl.styles import PatternFill, Font, Alignment
            from openpyxl.styles.numbers import FORMAT_DATE_DATETIME

            wb = load_workbook(output_path)
            ws = wb['ETL Export']

            # ── Row 1 — "FinJournals" banner ──────────────────────────────
            banner_fill = PatternFill(start_color='1F3864',
                                      end_color='1F3864', fill_type='solid')
            banner_font = Font(name='Segoe UI', bold=True,
                               color='FFFFFF', size=11)
            for cell in ws[1]:
                cell.fill = banner_fill
                cell.font = banner_font
                cell.alignment = Alignment(horizontal='center',
                                           vertical='center')

            # ── Row 2 — column headers ────────────────────────────────────
            header_fill = PatternFill(start_color='2E75B6',
                                      end_color='2E75B6', fill_type='solid')
            header_font = Font(name='Segoe UI', bold=True,
                               color='FFFFFF', size=10)
            for cell in ws[2]:
                cell.fill = header_fill
                cell.font = header_font
                cell.alignment = Alignment(horizontal='center',
                                           vertical='center')

            # ── Data rows — fix POSTMONTH to 1st of month as a date ───────
            #    Also format DATE and POSTMONTH columns as dates
            for row in ws.iter_rows(min_row=3, max_row=ws.max_row):
                for cell in row:
                    # POSTMONTH is column 5 (index 4, col E)
                    if cell.column == 5 and cell.value:
                        try:
                            # Parse "YYYY-MM" → first day of month datetime
                            dt = datetime.strptime(str(cell.value), '%Y-%m')
                            cell.value = dt
                            cell.number_format = 'MM/DD/YYYY'
                            cell.alignment = Alignment(horizontal='center')
                        except Exception:
                            pass

                    # DATE is column 2 (col B) — ensure date format
                    if cell.column == 2 and cell.value:
                        cell.alignment = Alignment(horizontal='center')

                    # AMOUNT is column 7 (col G) — number format
                    if cell.column == 7 and cell.value not in ('', None):
                        cell.number_format = '#,##0.00'
                        cell.alignment = Alignment(horizontal='right')

            # ── Column widths ─────────────────────────────────────────────
            col_widths = {
                1: 10,  # TRANNUM
                2: 12,  # DATE
                3: 8,  # PROPERTY
                4: 14,  # ACCOUNT
                5: 14,  # POSTMONTH
                6: 10,  # BOOKNUM
                7: 14,  # AMOUNT
                8: 35,  # REMARK
                9: 10,  # REF
                10: 10,  # DETAILNOTES
            }
            for col_idx, width in col_widths.items():
                ws.column_dimensions[
                    ws.cell(1, col_idx).column_letter
                ].width = width

            wb.save(output_path)
            wb.close()
            # ─────────────────────────────────────────────────────────────

            return True, f"Exported {len(sorted_dates)} journal entries ({len(rows) // 2} transactions)"
        except Exception as e:
            return False, str(e)


